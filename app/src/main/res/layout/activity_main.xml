<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- App Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EDGY Privacy Filter"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp" />

        <!-- Model Info (Stage 4: tap to show detailed info) -->
        <TextView
            android:id="@+id/tvModelInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_model_info"
            android:textSize="12sp"
            android:layout_marginBottom="16dp" />

        <!-- Privacy Tier Selection -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_tier"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <RadioGroup
            android:id="@+id/rgTier"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <RadioButton
                android:id="@+id/rbLow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tier_low"
                android:checked="true" />

            <RadioButton
                android:id="@+id/rbModerate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tier_moderate" />

            <RadioButton
                android:id="@+id/rbHigh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tier_high" />

        </RadioGroup>

        <!-- Stage 3: Real-time capture controls -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Real-Time Capture"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btnStartCapture"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/btn_start_capture"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnStopCapture"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/btn_stop_capture"
                android:enabled="false"
                android:layout_marginStart="4dp" />

        </LinearLayout>

        <!-- Live playback toggle -->
        <Button
            android:id="@+id/btnTogglePlayback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_listen_start"
            android:enabled="false"
            android:layout_marginBottom="8dp" />

        <!-- Live latency display -->
        <TextView
            android:id="@+id/tvLatency"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Latency: --"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:layout_marginBottom="4dp" />

        <!-- Capture stats -->
        <TextView
            android:id="@+id/tvCaptureStats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Capture: idle"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:layout_marginBottom="16dp" />

        <!-- Stage 1-2: Offline processing -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Offline Processing"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnProcessTest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_process"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnPickFile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_pick_file"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnProcessFile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_process_file"
            android:enabled="false"
            android:layout_marginBottom="8dp" />

        <!-- Audio playback for processed file results -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/btnPlayResult"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/btn_play_result"
                android:enabled="false"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnStopPlayback"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/btn_stop_playback"
                android:enabled="false"
                android:layout_marginStart="4dp" />

        </LinearLayout>

        <!-- Stage 4: Model management -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Model Management"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btnReloadModel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/btn_reload_model"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnScanModels"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/btn_scan_models"
                android:layout_marginStart="4dp" />

        </LinearLayout>

        <!-- Inference stats display -->
        <TextView
            android:id="@+id/tvInferenceStats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Inference stats: --"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:layout_marginBottom="16dp" />

        <!-- Status -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_status"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <!-- Progress -->
        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:layout_marginBottom="16dp" />

        <!-- Results -->
        <TextView
            android:id="@+id/tvResults"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_results"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:background="#F5F5F5"
            android:padding="12dp"
            android:minHeight="200dp" />

    </LinearLayout>

</ScrollView>